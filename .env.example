# IBVAP environment. `make env` copies this to `.env` and
# fills JWT_SECRET, PLATE_HMAC_KEY, EVIDENCE_ENC_KEY with fresh random values
# — everything below is safe to commit precisely because none of it is a
# real secret, only local-dev defaults that match docker-compose.yml.

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=ibvap
DB_PASSWORD=ibvap_dev
DB_NAME=ibvap

# --- object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=ibvap
MINIO_SECRET_KEY=ibvap_dev_secret
MINIO_SECURE=false

# --- cache / bus ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- media (MediaMTX) ---
MEDIAMTX_HOST=localhost
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189    # actual RTP/ICE media socket -- see infra/mediamtx.yml

# --- crypto — `make env` overwrites these three with real random values.
# The placeholders below are refused at startup (Settings.warn_on_dev_secrets)
# so a `.env` that skipped `make env` fails loudly instead of running insecure.
JWT_SECRET=dev_only_change_me
PLATE_HMAC_KEY=dev_only_change_me
EVIDENCE_ENC_KEY=dev_only_change_me

# --- runtime ---
IBVAP_PROFILE=laptop
IBVAP_SITE=BOP-03
