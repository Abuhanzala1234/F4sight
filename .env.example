# Copy to .env. `make demo` generates one with random secrets if it is missing.
# Secrets NEVER go in config/ and NEVER go in git (BUILD_SPEC §11).

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=drishti
DB_PASSWORD=drishti_dev
DB_NAME=drishti

# --- MinIO (S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=drishti
MINIO_SECRET_KEY=drishti_dev_secret
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=drishti-evidence
MINIO_BUCKET_CLIPS=drishti-clips

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MediaMTX ---
MEDIAMTX_HOST=localhost
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889

# --- Crypto (CHANGE THESE. `openssl rand -hex 32` for each) ---
JWT_SECRET=dev_only_change_me_0000000000000000000000000000000000000000000000
PLATE_HMAC_KEY=dev_only_change_me_1111111111111111111111111111111111111111111111
EVIDENCE_ENC_KEY=dev_only_change_me_2222222222222222222222222222222222222222222222

# --- Runtime ---
DRISHTI_PROFILE=laptop          # laptop | bop | edge  (BUILD_SPEC §5)
DRISHTI_SITE=BOP-03
LOG_LEVEL=INFO
LOG_FORMAT=console              # console | json

# --- Config overrides use the DRISHTI__SECTION__KEY form (§11) ---
# DRISHTI__RULES__LOITER__SECONDS=45
# DRISHTI__DETECTOR__BACKEND=onnx
