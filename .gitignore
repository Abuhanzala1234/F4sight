# Secrets
.env
*.pem
*.key

# Models: free to download, too big to track. `make models` fetches them.
models/*
!models/.gitkeep

# Exception: this weapon model is fine-tuned on our own dataset, not a
# third-party download `make models` can re-fetch. Tracked deliberately so a
# fresh clone gets the trained weights, not the weaker stock model.
# (models/MANIFEST.json stays ignored -- `make models` regenerates it
# whenever any artefact, fetched or tracked, changes on disk. Un-ignoring a
# file inside an ignored directory also requires un-ignoring the directory
# entry itself, or git never descends far enough to see the file.)
!models/weapon/
models/weapon/*
!models/weapon/weapon-yolov8.onnx

# Media
recordings/
infra/fixtures/*.mp4
spool/

# Raw MOT16 downloads used ONCE to cut eval/clips/*.mp4 (scripts/evaluate.py
# only ever reads eval/clips/, never these) -- scratch, not shipped.
eval/_source/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dashboard/dist/
*.tsbuildinfo

# Ledger (mock backend writes here)
ledger_data/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local scratch tooling (screenshots, downloaded binaries, install traces) —
# never part of the shipped app.
.local-tools/
